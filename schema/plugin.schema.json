{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NOirBRight/dsh-plugins/blob/main/schema/plugin.schema.json",
  "title": "NOirBRight DSH catalog entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "packageName",
    "repository",
    "category",
    "version",
    "tag",
    "commit",
    "license",
    "profiles",
    "dshCompatibility",
    "status",
    "descriptions",
    "policyFlags"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "enum": [
        "plugin",
        "companion-app"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "packageName": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^NOirBRight/[A-Za-z0-9._-]+$"
    },
    "category": {
      "enum": [
        "models",
        "interface",
        "assistant",
        "remote",
        "observability"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "tag": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "license": {
      "enum": [
        "MIT",
        "NOASSERTION"
      ]
    },
    "profiles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "web",
          "headless"
        ]
      }
    },
    "dshCompatibility": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "active",
        "deprecated",
        "quarantined"
      ]
    },
    "descriptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "zh"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 20,
          "maxLength": 240
        },
        "zh": {
          "type": "string",
          "minLength": 8,
          "maxLength": 240
        }
      }
    },
    "policyFlags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "account-ban-risk",
          "browser-automation",
          "credentials",
          "network",
          "oauth",
          "remote-access",
          "session-data",
          "subprocess",
          "third-party-service",
          "third-party-subscription",
          "ui-extension",
          "unofficial-api"
        ]
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "downloadUrl",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "downloadUrl": {
          "type": "string",
          "pattern": "^https://github.com/NOirBRight/"
        },
        "latestUrl": {
          "type": "string",
          "pattern": "^https://github.com/NOirBRight/.+/releases/latest/download/"
        },
        "sha256Url": {
          "type": "string",
          "pattern": "^https://github.com/NOirBRight/.+/releases/download/"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset",
        "latestUrl",
        "fixedUrl",
        "sha256",
        "sha256Url"
      ],
      "properties": {
        "asset": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+\\.tgz$"
        },
        "latestUrl": {
          "type": "string",
          "pattern": "^https://github.com/NOirBRight/.+/releases/latest/download/"
        },
        "fixedUrl": {
          "type": "string",
          "pattern": "^https://github.com/NOirBRight/.+/releases/download/v"
        },
        "sha256Url": {
          "type": "string",
          "pattern": "^https://github.com/NOirBRight/.+/releases/download/v.+/SHA256SUMS$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "optional": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      }
    },
    "notice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "zh"
      ],
      "properties": {
        "en": {
          "type": "string"
        },
        "zh": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "plugin"
          }
        }
      },
      "then": {
        "properties": {
          "license": {
            "const": "MIT"
          },
          "profiles": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "companion-app"
          }
        }
      },
      "then": {
        "required": [
          "artifact"
        ],
        "properties": {
          "profiles": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NOirBRight/dsh-plugins/blob/main/schema/plugin.schema.json",
  "title": "NOirBRight DSH plugin catalog entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "packageName",
    "repository",
    "category",
    "version",
    "tag",
    "commit",
    "license",
    "profiles",
    "dshCompatibility",
    "status",
    "descriptions",
    "policyFlags"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "packageName": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^NOirBRight/[A-Za-z0-9._-]+$"
    },
    "category": {
      "enum": [
        "models",
        "interface",
        "assistant",
        "remote",
        "observability"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "tag": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "license": {
      "const": "MIT"
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "web",
          "headless"
        ]
      }
    },
    "dshCompatibility": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "active",
        "deprecated",
        "quarantined"
      ]
    },
    "descriptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "zh"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 20,
          "maxLength": 240
        },
        "zh": {
          "type": "string",
          "minLength": 8,
          "maxLength": 240
        }
      }
    },
    "policyFlags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "account-ban-risk",
          "browser-automation",
          "credentials",
          "network",
          "oauth",
          "remote-access",
          "session-data",
          "subprocess",
          "third-party-service",
          "third-party-subscription",
          "ui-extension",
          "unofficial-api"
        ]
      }
    },
    "notice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "zh"
      ],
      "properties": {
        "en": {
          "type": "string"
        },
        "zh": {
          "type": "string"
        }
      }
    }
  }
}
